# Copy this file to .env and fill it in. Never commit your real .env.

# Your Silo server's address, as you'd type it in a browser.
SILO_URL=https://silo.example.com

# A Silo API key owned by an admin, with the admin:monitor:read and libraries:read scopes.
SILO_API_KEY=sa_your_key_here

# Optional: create the first account at startup instead of using the setup
# page. You still set up two-factor authentication when you first sign in.
# ALMANAC_USERNAME=
# ALMANAC_PASSWORD=

# Behind a reverse proxy, so Almanac sees real IP addresses and HTTPS.
# TRUST_PROXY=false
# SECURE_COOKIES=auto

# Optional settings
# PORT=8191
# POLL_INTERVAL_SECONDS=5
# HISTORY_SYNC_SECONDS=60
# CATALOG_SYNC_MINUTES=5
# DATA_DIR=data

# Set to true to run with made-up demo data instead of a real Silo server.
# SILO_MOCK=false
