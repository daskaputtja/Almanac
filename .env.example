# Copy this file to .env and fill it in. Never commit your real .env.

# Your Silo server's address, as you'd type it in a browser.
SILO_URL=https://silo.example.com

# A Silo API key owned by an admin, with the admin:monitor:read scope.
SILO_API_KEY=sa_your_key_here

# Optional: require a username and password to open Almanac.
# Strongly recommended if Almanac can be reached from the internet,
# because the dashboard shows usernames and IP addresses.
ALMANAC_USERNAME=
ALMANAC_PASSWORD=

# Optional settings
# PORT=8191
# POLL_INTERVAL_SECONDS=5

# Set to true to run with made-up demo data instead of a real Silo server.
# SILO_MOCK=false
